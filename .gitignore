# Python
__pycache__/
*.pyc

# Скретч-каталоги для ручных прогонов при разработке srmod
/scratch_*/

# Локальный машинный конфиг (пути к чужим бинарникам — не для git)
/config.json

# Артефакты установки пакета
*.egg-info/
build/
dist/

# Расширение VS Code. Сгенерированные копии (extension/syntaxes, extension/data,
# extension/LICENSE, иконка) в git ЛЕЖАТ — как и канон в корне: иначе свежий
# клон не запустится по F5 без tools/sync_extension.py. Не для git — только
# зависимости и собранный пакет.
node_modules/
*.vsix
